# ---------------------------------------------------------------------------
# Scenario base parameters
# ---------------------------------------------------------------------------
SCENARIOS = {
    "normal": {
        "pph_base": 30,
        "prob_base": 0.00355,
        "variation": 0.08,
        "label": "NORMAL TRAFFIC",
        # jam has per-flow pph variation — normal/slow use uniform pph
        "jam_pph": None,
    },
    "slow": {
        "pph_base": 60,
        "prob_base": 0.0080,
        "variation": 0.08,
        "label": "SLOW TRAFFIC",
        "jam_pph": None,
    },
    "jam": {
        # Base pph per flow matching original jam file (74,75,90,75,73,85,90,75,75,90,75)
        "pph_base": None,
        "pph_per_flow": [74, 75, 90, 75, 73, 85, 90, 75, 75, 90, 75],
        "prob_base": 0.0120,
        "variation": 0.08,
        "label": "TRAFFIC JAM",
        "jam_pph": True,
    },
}


def vary(base, variation):
    delta = base * variation
    return round(base + random.uniform(-delta, delta), 5)


def build_xml(scenario_name, run_index):
    cfg = SCENARIOS[scenario_name]
    variation = cfg["variation"]

    # --- personFlows ---
    ped_lines = []
    for idx, (pf_id, from_e, to_e) in enumerate(PERSON_FLOWS):
        if cfg["jam_pph"]:
            base_pph = cfg["pph_per_flow"][idx]
        else:
            base_pph = cfg["pph_base"]
        pph = max(1, round(base_pph + random.uniform(-base_pph * variation,
                                                       base_pph * variation)))
        ped_lines.append(
            f'    <personFlow id="{pf_id}" type="ped" begin="0.00" end="3600.00" '
            f'personsPerHour="{pph}" departPos="25">\n'
            f'        <personTrip from="{from_e}" to="{to_e}"/>\n'
            f'    </personFlow>'
        )

    # --- vehicle flows ---
    veh_lines = []
    for (fid, vdist, from_e, to_e, via) in VEHICLE_FLOWS:
        p = vary(cfg["prob_base"], variation)
        via_attr = f' via="{via}"' if via else ""
        veh_lines.append(
            f'    <flow id="{fid}" type="{vdist}" begin="0.00" end="3600.00" '
            f'from="{from_e}" to="{to_e}"{via_attr} probability="{p}" '
            f'departLane="best" departSpeed="max"/>'
        )

    xml = (
        f'<?xml version="1.0" encoding="UTF-8"?>\n\n'
        f'<!-- {cfg["label"]} - Variant {run_index} -->\n'
        f'<!-- Generated by generate_balibago_demand_variants.py -->\n\n'
        f'<routes>\n'
        f'{VTYPES_BLOCK}\n\n'
        f'    <!-- Pedestrians -->\n'
        + "\n".join(ped_lines) + "\n\n"
        + "\n".join(veh_lines) + "\n\n"
        f'</routes>\n'
    )
    return xml


generated = []
for scenario in ["normal", "slow", "jam"]:
    for i in range(1, 11):
        filename = f"flows_{scenario}_traffic_{i:02d}.rou.xml"
        filepath = os.path.join(OUTPUT_DIR, filename)
        with open(filepath, "w", encoding="utf-8") as f:
            f.write(build_xml(scenario, i))
        generated.append(filepath)
        print(f"  Generated: {filepath}")

print(f"\nDone. {len(generated)} route files written to '{OUTPUT_DIR}/'")