df = pd.DataFrame(data_records)

def run_full_analysis(metric_name, col_name):
    print(f"\n{'='*80}")
    print(f"COMPREHENSIVE ANALYSIS: {metric_name}")
    print(f"{'='*80}")

    # --- PART 1: DESCRIPTIVE STATISTICS ---
    print("\n[1] DESCRIPTIVE STATISTICS:")
    stats = df.groupby('Algorithm')[col_name].agg(['count', 'mean', 'std', 'min', 'max'])
    stats['CV%'] = (stats['std'] / stats['mean']) * 100
    print(stats.round(2))

    # --- PART 2: NORMALITY ---
    print("\n[2] NORMALITY TEST (Shapiro-Wilk):")
    for loc in df['Location'].unique():
        stat, p = shapiro(df[df['Location'] == loc][col_name])
        print(f"  {loc:12s}: p={p:.4f} ({'Normal' if p > 0.05 else 'NOT Normal'})")

    # --- PART 3: ANOVA ---
    print("\n[3] TWO-WAY ANOVA (Location * Algorithm):")
    formula = f'{col_name} ~ C(Location) + C(Algorithm) + C(Location):C(Algorithm)'
    model = ols(formula, data=df).fit()
    anova_table = sm.stats.anova_lm(model, typ=2)
    
    # Calculate Eta-Squared (Effect Size)
    anova_table['eta_sq'] = anova_table['sum_sq'] / sum(anova_table['sum_sq'])
    print(anova_table.round(4))

    # --- PART 4: KRUSKAL-WALLIS ---
    print("\n[4] KRUSKAL-WALLIS TEST (Algorithm):")
    groups = [group[col_name].values for name, group in df.groupby('Algorithm')]
    h_stat, p_val = kruskal(*groups)
    print(f"  H-stat: {h_stat:.4f}, p-value: {p_val:.4f}")

    # --- PART 5: TUKEY HSD ---
    print("\n[5] POST-HOC TUKEY HSD (Algorithm):")
    posthoc = pairwise_tukeyhsd(df[col_name], df['Algorithm'], alpha=0.05)
    print(posthoc.summary())

# Run for both
run_full_analysis("VEHICLE TIME LOSS", "Vehicle_TL")
run_full_analysis("PEDESTRIAN TIME LOSS", "Pedestrian_TL")